# Copy to .env and adjust. Never commit the real .env file.

# --- Django ---
# Which settings module to use: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# Local venv + local Postgres:   postgres://careerforge:careerforge@localhost:5432/careerforge
# Inside docker compose:          postgres://careerforge:careerforge@db:5432/careerforge
DATABASE_URL=postgres://careerforge:careerforge@localhost:5432/careerforge
POSTGRES_DB=careerforge
POSTGRES_USER=careerforge
POSTGRES_PASSWORD=careerforge

# --- CORS / CSRF (frontend origin, e.g. Vite dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Resume uploads ---
# Directory OUTSIDE any publicly served path. Relative paths resolve from backend/.
PRIVATE_MEDIA_ROOT=private_media
RESUME_MAX_UPLOAD_BYTES=5242880
RESUME_MAX_PAGES=20
# Below this many non-whitespace characters, a PDF is treated as scanned/image-only.
RESUME_MIN_TEXT_CHARS=50
RESUME_MAX_TEXT_CHARS=200000
# Keep the uploaded PDF after extracting its text (False = store text only).
RESUME_STORE_FILES=True

# --- Matching engine ---
# Share of the score from required skills when a job also has preferred skills (0.5-1.0).
MATCHING_REQUIRED_SHARE=0.8

# --- Rate limits (DRF throttle syntax: <count>/<second|minute|hour|day>) ---
THROTTLE_AUTH_RATE=10/minute
THROTTLE_UPLOAD_RATE=20/hour
THROTTLE_ANALYSIS_RATE=60/hour

# --- Logging ---
DJANGO_LOG_LEVEL=INFO

# --- Email (password reset) ---
# Development: emails (with reset links) are printed to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CareerForge <no-reply@localhost>
# Production on Render: EMAIL_BACKEND=apps.core.email_backends.BrevoAPIBackend + BREVO_API_KEY
BREVO_API_KEY=
PASSWORD_RESET_TIMEOUT=3600
THROTTLE_PASSWORD_RESET_RATE=5/hour
