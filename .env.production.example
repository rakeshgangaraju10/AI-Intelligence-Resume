# Production settings for docker-compose.prod.yml. Copy to .env.production
# (never commit it) and replace every "change-me" value.

# --- Django ---
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# The public hostname(s), comma separated, e.g. careerforge.example.com
DJANGO_ALLOWED_HOSTS=careerforge.example.com
# Full origin(s) the browser uses, e.g. https://careerforge.example.com
CSRF_TRUSTED_ORIGINS=https://careerforge.example.com
# Keep True when HTTPS terminates in front of nginx. Set False only for a
# local HTTP-only trial (cookies are Secure, so logging in needs HTTPS anyway).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=2592000
# Proxies in front of Django: 1 = this nginx only; 2 = nginx behind a load balancer.
DRF_NUM_PROXIES=1
DJANGO_LOG_LEVEL=INFO

# --- Database ---
POSTGRES_DB=careerforge
POSTGRES_USER=careerforge
POSTGRES_PASSWORD=change-me

# --- Web ---
HTTP_PORT=8080
GUNICORN_WORKERS=3

# --- Rate limits ---
# LocMem cache is per gunicorn worker; with several workers point CACHE_URL at
# Redis (e.g. redis://redis:6379/1) so limits are shared.
THROTTLE_AUTH_RATE=10/minute
THROTTLE_UPLOAD_RATE=20/hour
THROTTLE_ANALYSIS_RATE=60/hour

# --- Uploads / matching ---
RESUME_MAX_UPLOAD_BYTES=5242880
RESUME_MAX_PAGES=20
MATCHING_REQUIRED_SHARE=0.8
