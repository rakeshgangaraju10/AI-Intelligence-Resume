# Copy to .env.local for local overrides (Vite only exposes variables prefixed with VITE_).
# Client-side hint only; the server enforces RESUME_MAX_UPLOAD_BYTES.
VITE_MAX_UPLOAD_MB=5
# Where the dev server proxies /api (Django). Not exposed to the browser.
VITE_API_PROXY_TARGET=http://localhost:8000
